{
  "ConnectionStrings": {
    "Telemetry": "Host=localhost;Port=5432;Database=telemetry;Username=telemetry;Password=telemetry;Maximum Pool Size=64;Max Auto Prepare=16;Auto Prepare Min Usages=2;Command Timeout=15"
  },
  "Telemetry": {
    "MaxBatchSize": 1000,
    "DefaultHistoryLimit": 100,
    "MaxHistoryLimit": 10000,
    "DefaultHistoryWindow": "01:00:00"
  },
  "Emulator": {
    "Enabled": true,
    "TagCount": 100,
    "Interval": "00:00:01",
    "BadQualityRatio": 0.01
  },
  "Database": {
    "ApplySchemaOnStartup": true,
    "StartupConnectAttempts": 30,
    "StartupConnectDelay": "00:00:02"
  },
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 1048576
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Npgsql": "Warning"
    }
  },
  "AllowedHosts": "*"
}
